layout(location = 0) rayPayloadEXT Surface result;
layout(location = 1) rayPayloadEXT vec3 transmission;

void castRay(vec3 origin, vec3 direction, float minimumDistance, uint mask) {
    result.distance = -1.0;
    traceRayEXT(scene, gl_RayFlagsNoneEXT, mask, 0, 0, 0, origin, minimumDistance, direction, frame.originDeltaFar.w, 0);
}
void castRay(vec3 origin, vec3 direction, float minimumDistance) { castRay(origin, direction, minimumDistance, 0xff); }
vec3 sunVisibility(vec3 origin, vec3 direction) {
    // TODO(RT): replace fixed ray offsets with position-error bounds for large coordinates and thin surfaces.
    transmission = vec3(1);
    traceRayEXT(scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xff, 1, 0, 1, origin, 0.001, direction, frame.originDeltaFar.w, 1);
    return transmission;
}
vec2 pixelPosition(vec4 clip) { return (clip.xy / clip.w * 0.5 + 0.5) * frame.sizeJitter.xy; }
void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    // Inverting the game's projection displacement samples the opposite pixel offset.
    vec2 uv = (vec2(pixel) + 0.5 - frame.sizeJitter.zw) / frame.sizeJitter.xy;
    vec4 view = frame.inverseProjection * vec4(uv * 2.0 - 1.0, -1.0, 1.0);
    vec3 direction = normalize(mat3(frame.cameraToWorld) * (view.xyz / view.w));
    vec3 origin = frame.cameraToWorld[3].xyz;
    castRay(origin, direction, length(view.xyz / view.w), 0x7f);
    Surface primary = result;
    vec3 stable = primary.emission;
    vec3 diffuseSum = vec3(0), specularSum = vec3(0);
    uint seed = hash(uint(pixel.x) ^ hash(uint(pixel.y)) ^ hash(frame.options.x));
    float hitDistance = 0.0;
    float hitWeight = 0.0;
    float diffuseDistance = 0.0, diffuseWeight = 0.0;

    if (primary.distance >= 0.0) {
        for (uint sampleIndex = 0u; sampleIndex < max(frame.options.y, 1u); sampleIndex++) {
            Surface s = primary;
            vec3 ray = direction, throughput = vec3(1.0);
            vec3 diffuseThroughput = vec3(0), specularThroughput = vec3(0);
            vec3 diffuseLight = vec3(0), specularLight = vec3(0);
            for (uint bounce = 0u; bounce < max(frame.options.z, 1u); bounce++) {
                uint kind = s.kind & 0x7fffffffu;
                bool transmission = kind == 2u || kind == 3u;
                vec3 viewDirection = -ray;
                if (!transmission && frame.sunDirectionIntensity.w > 0.0) {
                    // TODO(RT): sample emissive geometry and importance-sample the actual sky texture, replacing the gradient environment.
                    vec3 light = normalize(frame.sunDirectionIntensity.xyz);
                    float cosine = max(dot(s.normal, light), 0.0);
                    if (cosine > 0.0) {
                        vec3 diffuse, specular; float pdf;
                        bsdf(s, viewDirection, light, diffuse, specular, pdf);
                        vec3 irradiance = frame.sunColour.rgb * frame.sunDirectionIntensity.w * cosine *
                            sunVisibility(s.position + s.normal * 0.002, light);
                        if (bounce == 0u) {
                            diffuseLight += throughput * diffuse * irradiance;
                            specularLight += throughput * specular * irradiance;
                        } else {
                            diffuseLight += diffuseThroughput * (diffuse + specular) * irradiance;
                            specularLight += specularThroughput * (diffuse + specular) * irradiance;
                        }
                    }
                }
                if (!transmission) {
                    vec3 light = sampleSkyDirection(s.normal, seed);
                    float cosine = max(dot(s.normal, light), 0.0);
                    float skyPdf = cosine / PI;
                    vec3 diffuse, specular; float bsdfPdf;
                    bsdf(s, viewDirection, light, diffuse, specular, bsdfPdf);
                    if (skyPdf > 1e-8) {
                        // A sky sample is visible only on a miss. Glass is a path
                        // vertex handled by BSDF transport, not a second straight-through estimator.
                        castRay(s.position + s.normal * 0.002, light, 0.001);
                        if (result.distance < 0.0) {
                            vec3 irradiance = max(result.emission, vec3(0)) * cosine / skyPdf * misWeight(skyPdf, bsdfPdf);
                            if (bounce == 0u) {
                                diffuseLight += diffuse * irradiance;
                                specularLight += specular * irradiance;
                            } else {
                                diffuseLight += diffuseThroughput * (diffuse + specular) * irradiance;
                                specularLight += specularThroughput * (diffuse + specular) * irradiance;
                            }
                        }
                    }
                }
                float escapedSkyWeight = 1.0;
                vec3 outgoing;
                if (transmission) {
                    float ior = kind == 3u ? 1.333 : 1.5;
                    float f0 = pow((ior - 1.0) / (ior + 1.0), 2.0);
                    float reflection = f0 + (1.0 - f0) * pow(1.0 - max(dot(s.normal, viewDirection), 0.0), 5.0);
                    vec3 transmitted = refract(ray, s.normal, (s.kind & 0x80000000u) == 0u ? 1.0 / ior : ior);
                    outgoing = random(seed) < reflection || dot(transmitted, transmitted) < 1e-8 ? reflect(ray, s.normal) : transmitted;
                    vec3 transmissionWeight = mix(vec3(1.0), s.albedo, 1.0 - s.opacity);
                    if (bounce == 0u) { diffuseThroughput = vec3(0); specularThroughput = transmissionWeight; }
                    else { diffuseThroughput *= transmissionWeight; specularThroughput *= transmissionWeight; }
                } else {
                    bool sampledSpecular;
                    outgoing = sampleBsdf(s, viewDirection, seed, sampledSpecular);
                    vec3 diffuse, specular; float pdf;
                    bsdf(s, viewDirection, outgoing, diffuse, specular, pdf);
                    if (pdf <= 1e-8) break;
                    escapedSkyWeight = misWeight(pdf, max(dot(s.normal, outgoing), 0.0) / PI);
                    float weight = max(dot(s.normal, outgoing), 0.0) / pdf;
                    if (bounce == 0u) { diffuseThroughput = diffuse * weight; specularThroughput = specular * weight; }
                    else {
                        diffuseThroughput *= (diffuse + specular) * weight;
                        specularThroughput *= (diffuse + specular) * weight;
                    }
                }
                throughput = diffuseThroughput + specularThroughput;
                if (bounce >= 2u) {
                    float survival = clamp(max(max(throughput.r, throughput.g), throughput.b), 0.05, 0.95);
                    if (random(seed) >= survival) break;
                    diffuseThroughput /= survival; specularThroughput /= survival;
                }
                vec3 nextOrigin = s.position + s.normal * (dot(outgoing, s.normal) >= 0.0 ? 0.002 : -0.002);
                castRay(nextOrigin, normalize(outgoing), 0.001);
                if (bounce == 0u) {
                    float contribution = max(max(specularThroughput.r, specularThroughput.g), specularThroughput.b);
                    float distance = result.distance >= 0.0 ? result.distance : frame.originDeltaFar.w;
                    hitDistance += distance * contribution; hitWeight += contribution;
                    float weight = max(max(diffuseThroughput.r, diffuseThroughput.g), diffuseThroughput.b);
                    diffuseDistance += distance * weight; diffuseWeight += weight;
                }
                float emissionWeight = result.distance < 0.0 ? escapedSkyWeight : 1.0;
                diffuseLight += diffuseThroughput * result.emission * emissionWeight;
                specularLight += specularThroughput * result.emission * emissionWeight;
                if (result.distance < 0.0) break;
                s = result; ray = normalize(outgoing);
            }
            diffuseSum += diffuseLight; specularSum += specularLight;
        }
        float inverseSamples = 1.0 / float(max(frame.options.y, 1u));
        diffuseSum *= inverseSamples; specularSum *= inverseSamples;
        hitDistance = hitWeight > 0.0 ? hitDistance / hitWeight : 0.0;
        diffuseDistance = diffuseWeight > 0.0 ? diffuseDistance / diffuseWeight : 0.0;
        vec4 current = frame.currentWorldToClip * vec4(primary.position, 1.0);
        vec4 previous = frame.previousWorldToClip * vec4(primary.previousPosition + frame.originDeltaFar.xyz, 1.0);
        vec2 velocity = previous.w > 0.0 && current.w > 0.0 && frame.options.w == 0u
            ? pixelPosition(previous) - pixelPosition(current) : vec2(0);
        imageStore(depth, pixel, vec4(current.z / current.w * 0.5 + 0.5));
        uint primaryKind = primary.kind & 0x7fffffffu;
        float viewZ = -(transpose(mat3(frame.cameraToWorld)) * (primary.position - origin)).z;
        imageStore(viewDepth, pixel, vec4(primaryKind == 2u || primaryKind == 3u ? frame.originDeltaFar.w + 1.0 : max(viewZ, 0.0)));
        imageStore(motion, pixel, vec4(velocity, 0, 0));
        imageStore(normalRoughness, pixel, vec4(primary.normal, primary.roughness));
        imageStore(diffuseAlbedo, pixel, vec4(primary.albedo * (1.0 - primary.metallic), 1));
        imageStore(specularAlbedo, pixel, vec4(mix(vec3(0.04), primary.albedo, primary.metallic), 1));
    } else {
        imageStore(depth, pixel, vec4(1));
        imageStore(viewDepth, pixel, vec4(frame.originDeltaFar.w + 1.0));
        vec4 current = frame.currentWorldToClip * vec4(direction, 0);
        vec4 previous = frame.previousWorldToClip * vec4(direction, 0);
        imageStore(motion, pixel, vec4(previous.w > 0.0 && current.w > 0.0 && frame.options.w == 0u
            ? pixelPosition(previous) - pixelPosition(current) : vec2(0), 0, 0));
        // Background is stable radiance with a direction guide, not an uninitialized material pixel.
        imageStore(normalRoughness, pixel, vec4(-direction, 1));
        imageStore(diffuseAlbedo, pixel, vec4(1));
        imageStore(specularAlbedo, pixel, vec4(0.04, 0.04, 0.04, 1));
    }
    imageStore(noisyColour, pixel, vec4(stable + diffuseSum + specularSum, 1));
    imageStore(noisyDiffuse, pixel, vec4(clamp(diffuseSum, vec3(0), vec3(65504)), clamp(diffuseDistance, 0.0, 65504.0)));
    imageStore(noisySpecular, pixel, vec4(clamp(specularSum, vec3(0), vec3(65504)), clamp(hitDistance, 0.0, 65504.0)));
    imageStore(stableRadiance, pixel, vec4(stable, 1));
    imageStore(glow, pixel, vec4(primary.glow));
    imageStore(specularDistance, pixel, vec4(hitDistance));
}
