layout(location = 1) rayPayloadInEXT vec3 transmission;
hitAttributeEXT vec2 barycentric;
void main() {
    Geometry mesh; Vertex a, b, c;
    triangle(uint(gl_InstanceCustomIndexEXT), uint(gl_PrimitiveID), mesh, a, b, c);
    vec3 weights = vec3(1.0 - barycentric.x - barycentric.y, barycentric);
    vec4 colour = textureColour(mesh, a, b, c, weights, gl_HitTEXT);
    if (colour.a < 0.01) { ignoreIntersectionEXT; return; }
    if (mesh.kind == 2u || mesh.kind == 3u) {
        transmission *= mix(vec3(1.0), colour.rgb, 1.0 - clamp(colour.a, 0.0, 1.0));
        ignoreIntersectionEXT;
        return;
    }
    transmission = vec3(0);
}
