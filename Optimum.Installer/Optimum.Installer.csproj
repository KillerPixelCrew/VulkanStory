<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Optimum.Installer</RootNamespace>
    <AssemblyName>Optimum.Installer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Avalonia GUI for the Optimum installer. Links Optimum.Bootstrap.Core in-process.</Description>
    <Version>$(OptimumVersion)</Version>
    <ApplicationIcon>..\Optimum.Launcher\optimum.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bundled OFL 1.1 fonts: Lexend (all UI text), JetBrains Mono (log and
         commands). Licences ship beside the executable. -->
    <AvaloniaResource Include="Assets/Fonts/**/*.ttf" />
    <AvaloniaResource Include="Assets/optimum-logo.png" />
    <AvaloniaResource Include="Assets/optimum-grain.png" />
    <None Include="Assets/Fonts/Lexend/OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licences/OFL-Lexend.txt" />
    <None Include="Assets/Fonts/JetBrainsMono/OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licences/OFL-JetBrainsMono.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <!-- FluentAvalonia brings the real WinUI 3 / Windows 11 look: the
         FluentAvaloniaTheme, WinUI controls (NavigationView, ProgressRing,
         FAComboBox), and the full WinUI resource brush set. 3.1.0 targets
         Avalonia >= 12.1.0. -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optimum.Bootstrap.Core\Optimum.Bootstrap.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Optimum.Installer.Tests" />
  </ItemGroup>
</Project>
