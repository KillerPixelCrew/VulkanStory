<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:Optimum.Installer"
             x:Class="Optimum.Installer.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <!-- FluentAvalonia = the real WinUI 3 / Windows 11 look. It uses the OS
         accent colour and the OS light/dark setting, and ships the full WinUI
         resource brush set (TextFillColor*, CardBackgroundFillColor*,
         SystemFillColor*, etc.). No custom palette. -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />

    <!-- The only shared helper: a standard WinUI "card" surface (a rounded
         Border using the stock CardBackground/CardStroke tokens). -->
    <Style Selector="Border.Card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Application.Styles>
</Application>
