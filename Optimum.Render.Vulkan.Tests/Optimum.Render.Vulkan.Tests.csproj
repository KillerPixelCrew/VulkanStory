<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The vanilla shaders are proprietary and never committed, so corpus tests
         skip on a checkout that has not bootstrapped rather than failing. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\tests\Support\RepositoryFixture.cs" Link="Support\RepositoryFixture.cs" />
    <ProjectReference Include="..\Optimum.Render.Vulkan\Optimum.Render.Vulkan.csproj" />
    <!-- The renderer references the donor lib compile-only; PlatformSubstitutionTests
         load VulkanClientPlatform, so the test host needs the donor at runtime. -->
    <ProjectReference Include="..\build\VintagestoryLib\VintagestoryLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unlike the renderer project, the test host has to load this at runtime,
         so it is copied to the output directory. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>..\.vanilla\win-x64\vintagestory\VintagestoryAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>..\.vanilla\win-x64\vintagestory\Lib\OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyFsr3ProbeRuntimes" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/OptimumXessFg.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/OptimumXessFg.dll')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/OptimumFsr3.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/OptimumFsr3.dll')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/amd_fidelityfx_vk.dll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)/../bin/$(Configuration)/net10.0/amd_fidelityfx_vk.dll')" />
  </Target>

</Project>
