#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 64) in;
struct State { dvec4 position; vec4 velocityAge; vec4 motionAlive; };
struct Instance {
    dvec2 cameraXY;
    double cameraZ;
    uint source;
    uint target;
    vec4 interpolation;
    uvec4 uploadDelta;
};
layout(binding = 0, std430) readonly buffer States { State values[]; } states;
layout(binding = 1, std430) readonly buffer Instances { Instance values[]; } instances;
layout(binding = 2, std430) buffer Centers { uint values[]; } centers;
layout(push_constant) uniform Parameters { uint count; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    Instance instance = instances.values[i];
    precise dvec3 position = states.values[instance.source].position.xyz;
    precise dvec3 interpolated = position - dvec3(instance.interpolation.xyz);
    precise dvec3 relative = interpolated - dvec3(instance.cameraXY, instance.cameraZ);
    uvec3 bits = floatBitsToUint(vec3(relative)) + instance.uploadDelta.xyz;
    uint target = instance.target * 4;
    centers.values[target] = bits.x;
    centers.values[target + 1] = bits.y;
    centers.values[target + 2] = bits.z;
}
