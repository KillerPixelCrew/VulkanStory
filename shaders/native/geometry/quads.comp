#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
layout(binding = 0, std430) readonly buffer Vertices { float values[]; } vertices;
layout(binding = 1, std430) readonly buffer Instances { float values[]; } instances;
layout(binding = 2, std430) readonly buffer Flags { int values[]; } flags;
layout(binding = 3, std430) readonly buffer Directions { uint values[]; } directions;
layout(binding = 4, std430) readonly buffer State {
    mat4 view; vec4 counters; vec4 wind; vec4 effects; vec4 eye;
    mat4 previousView; vec4 previousCounters; vec4 previousWind; vec4 previousEffects; vec4 previousEye;
} state;
layout(binding = 5, std430) writeonly buffer Geometry { vec4 values[]; } geometry;
layout(binding = 6, std430) readonly buffer History { float values[]; } history;
layout(push_constant) uniform Parameters {
    uint vertexCount; uint instanceCount; uint vertexStride; uint vertexOffset;
    uint instanceStride; uint instanceOffset; uint flagStride; uint flagOffset;
    uint directionStride; uint directionOffset; int waving;
    uint historyStride; uint historyOffset; uint hasHistory;
} p;
#define OPTIMUM_WAVINGSTUFF p.waving
#include "../include/vertexflagbits.glsl"
#include "../include/noise3d.glsl"
#include "../include/warpstate.glsl"
#include "../include/quad.glsl"
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.vertexCount * p.instanceCount) return;
    uint particle = index / p.vertexCount, vertex = index % p.vertexCount;
    uint source = p.vertexOffset + vertex * p.vertexStride;
    uint instance = p.instanceOffset + particle * p.instanceStride;
    vec3 origin = vec3(instances.values[instance], instances.values[instance + 1], instances.values[instance + 2]);
    vec3 position = vec3(vertices.values[source], vertices.values[source + 1], vertices.values[source + 2]) * instances.values[instance + 3];
    int renderFlags = flags.values[p.flagOffset + particle * p.flagStride];
    bool rain = renderFlags < 0;
    uint packed = directions.values[p.directionOffset + particle * p.directionStride];
    vec3 direction = vec3(packed & 255u, (packed >> 8) & 255u, (packed >> 16) & 255u) / 255.0;
    mat4 view = vsQuadBillboard(state.view, origin, direction, rain);
    WarpState warp = WarpState(state.counters.x, state.counters.y, state.counters.z, state.counters.w,
        state.wind.x, state.eye.xyz, state.wind.y, state.wind.z, state.wind.w, state.effects.x,
        floatBitsToInt(state.eye.w), state.effects.y);
    vec4 world = vsQuadWarp(warp, position, rain, renderFlags);
    uint target = index * 7;
    geometry.values[target] = view * world;
    geometry.values[target + 1] = vec4(world.xyz + origin, world.w);
    for (uint column = 0; column < 4; column++) geometry.values[target + 2 + column] = view[column];
    vec4 previousCamera = vec4(0.0);
    if (p.hasHistory != 0u) {
        uint at = p.historyOffset + particle * p.historyStride;
        if (history.values[at + 10] > 0.5) {
            vec3 oldOrigin = vec3(history.values[at], history.values[at + 1], history.values[at + 2]);
            vec3 oldScale = vec3(history.values[at + 3], history.values[at + 4], history.values[at + 5]);
            vec3 oldDirection = vec3(history.values[at + 6], history.values[at + 7], history.values[at + 8]);
            WarpState oldWarp = WarpState(state.previousCounters.x, state.previousCounters.y, state.previousCounters.z, state.previousCounters.w,
                state.previousWind.x, state.previousEye.xyz, state.previousWind.y, state.previousWind.z, state.previousWind.w,
                state.previousEffects.x, floatBitsToInt(state.previousEye.w), state.previousEffects.y);
            vec3 oldVertex = vec3(vertices.values[source], vertices.values[source + 1], vertices.values[source + 2]) * oldScale;
            previousCamera = vsQuadBillboard(state.previousView, oldOrigin, oldDirection, rain) * vsQuadWarp(oldWarp, oldVertex, rain, renderFlags);
        }
    }
    geometry.values[target + 6] = previousCamera;
}
