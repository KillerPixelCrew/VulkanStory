#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
struct Evolution { vec4 values; ivec4 control; };
layout(binding = 0, std430) readonly buffer FloatInput { float values[]; } sourceFloats;
layout(binding = 1, std430) readonly buffer ByteInput { uint values[]; } sourceBytes;
layout(binding = 2, std430) readonly buffer Properties { Evolution values[]; } properties;
layout(binding = 3, std430) readonly buffer History { float values[]; } history;
layout(binding = 4, std430) readonly buffer PreviousSize { Evolution values[]; } previousSize;
layout(binding = 5, std430) readonly buffer Trigonometry { float values[]; } table;
layout(binding = 6, std430) writeonly buffer Result { uint values[]; } result;
layout(push_constant) uniform Parameters { uint count; uint withHistory; } p;
#include "../include/evolution.glsl"
uint component(float value) { return uint(int(value)) & 255u; }
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.count) return;
    uint floats = index * 4, bytes = index * 3, property = index * 5;
    result.values[floats] = floatBitsToUint(sourceFloats.values[floats]);
    result.values[floats + 1] = floatBitsToUint(sourceFloats.values[floats + 1]);
    result.values[floats + 2] = floatBitsToUint(sourceFloats.values[floats + 2]);
    result.values[floats + 3] = floatBitsToUint(evaluate(properties.values[property]));
    uint target = p.count * 4 + bytes;
    result.values[target] = sourceBytes.values[bytes];
    result.values[target + 1] = sourceBytes.values[bytes + 1];
    uint color = sourceBytes.values[bytes + 2];
    uint blue = component(float(color & 255u) + evaluate(properties.values[property + 4]));
    uint green = component(float((color >> 8) & 255u) + evaluate(properties.values[property + 3]));
    uint red = component(float((color >> 16) & 255u) + evaluate(properties.values[property + 2]));
    uint alpha = component(clamp(evaluate(properties.values[property + 1]), 0.0, 255.0));
    result.values[target + 2] = blue | (green << 8) | (red << 16) | (alpha << 24);
    if (p.withHistory != 0u) {
        uint last = index * 11, outputAt = p.count * 7 + last;
        for (uint i = 0; i < 11; i++) result.values[outputAt + i] = floatBitsToUint(history.values[last + i]);
        uint size = floatBitsToUint(evaluate(previousSize.values[index]));
        result.values[outputAt + 3] = result.values[outputAt + 4] = result.values[outputAt + 5] = size;
    }
}
