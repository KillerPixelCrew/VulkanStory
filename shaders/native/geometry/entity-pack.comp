#version 450
// Bit-preserving standard rigid streams; CPU upload certificates bound every index.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Positions { uint xyz[]; };
layout(set = 0, binding = 1, std430) readonly buffer Uvs { uint uv[]; };
layout(set = 0, binding = 2, std430) readonly buffer Colors { uint rgba[]; };
layout(set = 0, binding = 3, std430) readonly buffer Flags { uint flags[]; };
layout(set = 0, binding = 4, std430) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 5, std430) writeonly buffer PackedVertices { uint vertices[]; };
layout(set = 0, binding = 6, std430) writeonly buffer PackedIndices { uint packedIndices[]; };
layout(push_constant) uniform Pack {
    uint vertexCount;
    uint indexCount;
    uint vertexBase;
    uint indexBase;
    uint uvBase;
    uint rgbaBase;
    uint flagsBase;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.vertexCount) {
        uint v = p.vertexBase + i;
        vertices[v * 3] = xyz[i * 3];
        vertices[v * 3 + 1] = xyz[i * 3 + 1];
        vertices[v * 3 + 2] = xyz[i * 3 + 2];
        vertices[p.uvBase + v * 2] = uv[i * 2];
        vertices[p.uvBase + v * 2 + 1] = uv[i * 2 + 1];
        vertices[p.rgbaBase + v] = rgba[i];
        vertices[p.flagsBase + v] = flags[i];
    }
    if (i < p.indexCount) packedIndices[p.indexBase + i] = indices[i] + p.vertexBase;
}
