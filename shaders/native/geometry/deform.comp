#version 450
layout(local_size_x = 64) in;
layout(binding = 0, std430) readonly buffer Positions { float values[]; } positions;
layout(binding = 1, std430) readonly buffer JointIds { int values[]; } ids;
layout(binding = 2, std140) readonly buffer Joints { mat4 values[]; } joints;
layout(binding = 3, std430) writeonly buffer Geometry { vec4 values[]; } geometry;
layout(push_constant) uniform Parameters {
    uint count; uint positionStride; uint positionOffset; uint jointStride; uint jointOffset; uint jointCount;
} p;
void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.count) return;
    uint source = p.positionOffset + index * p.positionStride;
    vec4 position = vec4(positions.values[source], positions.values[source + 1], positions.values[source + 2], 1.0);
    int jointId = ids.values[p.jointOffset + index * p.jointStride];
    mat4 joint = mat4(0.0);
    if (jointId >= 0 && uint(jointId) < p.jointCount) joint = joints.values[jointId];
    // Local geometry is view-independent. Keep the complete transformed normal basis
    // so draw-specific packed normals and flags retain their original semantics.
    geometry.values[index * 4] = joint * position;
    geometry.values[index * 4 + 1] = joint[0];
    geometry.values[index * 4 + 2] = joint[1];
    geometry.values[index * 4 + 3] = joint[2];
}
