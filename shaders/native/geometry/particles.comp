#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
layout(binding = 0, std430) readonly buffer Vertices { float values[]; } vertices;
layout(binding = 1, std430) readonly buffer Instances { float values[]; } instances;
layout(binding = 2, std430) readonly buffer Flags { int values[]; } flags;
layout(binding = 3, std430) readonly buffer History { float values[]; } history;
layout(binding = 4, std430) readonly buffer States { vec4 values[]; } states;
layout(binding = 5, std430) writeonly buffer Geometry { vec4 values[]; } geometry;
layout(push_constant) uniform Parameters {
    uint vertexCount; uint instanceCount; uint vertexStride; uint vertexOffset;
    uint instanceStride; uint instanceOffset; uint flagStride; uint flagOffset;
    uint historyStride; uint historyOffset; int waving;
} p;
#define OPTIMUM_WAVINGSTUFF p.waving
#include "../include/vertexflagbits.glsl"
#include "../include/noise3d.glsl"
#include "../include/warpstate.glsl"
WarpState warpState(uint at) {
    vec4 counters = states.values[at], wind = states.values[at + 1], effects = states.values[at + 2], eye = states.values[at + 3];
    return WarpState(counters.x, counters.y, counters.z, counters.w, wind.x, eye.xyz,
        wind.y, wind.z, wind.w, effects.x, floatBitsToInt(eye.w), effects.y);
}
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.vertexCount * p.instanceCount) return;
    uint particle = index / p.vertexCount, vertex = index % p.vertexCount;
    uint source = p.vertexOffset + vertex * p.vertexStride;
    vec3 position = vec3(vertices.values[source], vertices.values[source + 1], vertices.values[source + 2]);
    uint instance = p.instanceOffset + particle * p.instanceStride;
    vec3 origin = vec3(instances.values[instance], instances.values[instance + 1], instances.values[instance + 2]);
    vec4 current = vec4(position * instances.values[instance + 3] + origin, 1.0);
    int renderFlags = flags.values[p.flagOffset + particle * p.flagStride];
    current = applyGlobalWarpingState(warpState(0), applyVertexWarpingState(warpState(0), renderFlags, current));
    geometry.values[index * 2] = current;
    uint previous = p.historyOffset + particle * p.historyStride;
    vec4 last = vec4(0.0);
    if (history.values[previous + 10] > 0.5) {
        vec3 prevOrigin = vec3(history.values[previous], history.values[previous + 1], history.values[previous + 2]);
        vec3 prevScale = vec3(history.values[previous + 3], history.values[previous + 4], history.values[previous + 5]);
        last = vec4(position * prevScale + prevOrigin, 1.0);
        last = applyGlobalWarpingState(warpState(4), applyVertexWarpingState(warpState(4), renderFlags, last));
    }
    geometry.values[index * 2 + 1] = last;
}
