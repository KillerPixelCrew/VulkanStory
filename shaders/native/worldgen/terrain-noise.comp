#version 450
#extension GL_GOOGLE_include_directive : require
// Raw-noise arithmetic adapted from Vintage Story NewSimplexNoiseLayer, Anego Studios.
// Proprietary software owned by Anego Studios. All rights reserved.
// You may NOT sell this software in any way, shape or form.
// You may NOT copy, compile or distribute this software in its unmodified form.
// You may read it, learn from it, and use it as a basis for mods of the game
// Vintage Story, but your mod should be made of at least 50% of your original
// work, measured by lines of code.
// In other words, please don't distribute just slightly modified versions of this as your own mod.
// Rotation, floor and fractional conversion run on the CPU with stock double arithmetic.
// All raw arithmetic below uses explicit binary32 RNE operations on integer bits.
#include "terrain-binary32.glsl"
layout(local_size_x=64) in;
struct Input { uvec2 seed; uvec2 xp; uvec2 yp; uvec2 zp; uvec4 fraction; };
layout(std430,set=0,binding=0) readonly buffer Inputs { Input samples[]; };
layout(std430,set=0,binding=1) writeonly buffer Outputs { uint results[]; };
layout(std430,set=0,binding=2) readonly buffer Gradients { uint gradients[]; };
layout(push_constant) uniform Count { uint count; } pc;
#include "terrain-noise-kernel.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x; if(i>=pc.count) return;
    Input item=samples[i]; xp=item.xp; yp=item.yp; zp=item.zp;
    results[i]=Noise(item.seed,item.fraction.x,item.fraction.y,item.fraction.z);
}
