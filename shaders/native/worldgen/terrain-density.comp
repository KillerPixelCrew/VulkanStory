#version 450
#extension GL_GOOGLE_include_directive : require
// ColumnNoise.NoiseSign and threshold arithmetic adapted from Vintage Story,
// Anego Studios. Proprietary software owned by Anego Studios. All rights reserved.
// You may NOT sell this software in any way, shape or form.
// You may NOT copy, compile or distribute this software in its unmodified form.
// You may read it, learn from it, and use it as a basis for mods of the game
// Vintage Story, but your mod should be made of at least 50% of your original
// work, measured by lines of code.
// In other words, please don't distribute just slightly modified versions of this as your own mod.
// One invocation consumes one original column's ordered sign requests. Cached
// octave evaluations persist across Y, exactly as in the official ColumnNoise.
#include "terrain-binary32.glsl"
#include "terrain-binary64.glsl"
layout(local_size_x=64) in;
layout(std430,set=0,binding=0) readonly buffer Inputs { uint data[]; };
layout(std430,set=0,binding=1) writeonly buffer Outputs { uint results[]; };
layout(std430,set=0,binding=2) readonly buffer Gradients { uint gradients[]; };
layout(push_constant) uniform Count { uint count; } pc;
#include "terrain-noise-kernel.glsl"

// Original decimal literals rounded to binary64, stored as (low32, high32).
// Generated with Python struct.pack('<d', float(literal)), not recomputed in GLSL.
const uvec2 DENSITY_SKEW = uvec2(0x74df99c3u,0xbfcb0cb1u); // -0.211324865405187
const uvec2 DENSITY_ROTATE = uvec2(0x4590331eu,0x3fe279a7u); // 0.577350269189626
const uvec2 DENSITY_NEG_ROTATE = uvec2(0x4590331eu,0xbfe279a7u); // -0.577350269189626
const uvec2 DENSITY_INT_MIN = uvec2(0x00000000u,0xc1e00000u); // -2147483648.0
const uvec2 DENSITY_INT_MAX = uvec2(0xffc00000u,0x41dfffffu); // 2147483647.0 (exclusive)

struct Octave { uvec2 seed; uvec2 x,fy,z,amplitude,threshold,smoothing,stop; };
uvec2 ReadBinary64(uint word) { return uvec2(data[word],data[word+1u]); }
Octave ReadOctave(uint index) {
    uint p=data[1]+index*16u;
    return Octave(uvec2(data[p],data[p+1u]),ReadBinary64(p+2u),ReadBinary64(p+4u),ReadBinary64(p+6u),
        ReadBinary64(p+8u),ReadBinary64(p+10u),ReadBinary64(p+12u),ReadBinary64(p+14u));
}
uvec2 Threshold(uvec2 value,uvec2 threshold,uvec2 smoothing) {
    uvec2 b1=B64Sub(value,threshold),b2=B64Add(value,threshold);
    uvec2 d1=B64Sub(B64_ZERO,b1),d2=B64Sub(B64_ZERO,b2);
    uvec2 n1=B64Sub(smoothing,B64Abs(d1)),n2=B64Sub(smoothing,B64Abs(d2));
    uvec2 h1=B64Div(B64Max(n1,B64_ZERO),smoothing),h2=B64Div(B64Max(n2,B64_ZERO),smoothing);
    uvec2 c1=B64Mul(h1,h1),c2=B64Mul(h2,h2);
    c1=B64Mul(c1,smoothing); c2=B64Mul(c2,smoothing);
    c1=B64Mul(c1,B64_QUARTER); c2=B64Mul(c2,B64_QUARTER);
    uvec2 high=B64Add(B64Max(B64_ZERO,b1),c1),low=B64Sub(B64Min(B64_ZERO,b2),c2);
    uvec2 result=B64Add(high,low);
    return result;
}
uvec2 Prime(int i,uvec2 p) {
    uint high,low; umulExtended(uint(i),p.x,high,low);
    high+=uint(i)*p.y+(i<0?0xffffffffu:0u)*p.x;
    return uvec2(low,high);
}
uvec2 Evaluate(Octave o,uvec2 y,inout bool valid) {
    uvec2 xz=B64Add(o.x,o.z);
    uvec2 s2=B64Mul(xz,DENSITY_SKEW),yy=B64Mul(y,DENSITY_ROTATE);
    uvec2 xr=B64Add(o.x,s2),zr=B64Add(o.z,s2),yr=B64Mul(xz,DENSITY_NEG_ROTATE);
    xr=B64Add(xr,yy); zr=B64Add(zr,yy); yr=B64Add(yr,yy);
    if(B64IsNaN(xr)||B64IsNaN(yr)||B64IsNaN(zr)||B64IsInf(xr)||B64IsInf(yr)||B64IsInf(zr)||
        B64Lt(xr,DENSITY_INT_MIN)||B64Ge(xr,DENSITY_INT_MAX)||
        B64Lt(yr,DENSITY_INT_MIN)||B64Ge(yr,DENSITY_INT_MAX)||
        B64Lt(zr,DENSITY_INT_MIN)||B64Ge(zr,DENSITY_INT_MAX)) {
        valid=false; return B64_ZERO;
    }
    // Floor before conversion, including negative fractions. The checks above
    // retain the original finite int32-range precondition of B64ToI32.
    int ix=B64ToI32(B64Floor(xr)),iy=B64ToI32(B64Floor(yr)),iz=B64ToI32(B64Floor(zr));
    uvec2 fx=B64Sub(xr,B64FromI32(ix)),fy=B64Sub(yr,B64FromI32(iy)),fz=B64Sub(zr,B64FromI32(iz));
    xp=Prime(ix,PX); yp=Prime(iy,PY); zp=Prime(iz,PZ);
    return B64FromB32(Noise(o.seed,B64ToB32(fx),B64ToB32(fy),B64ToB32(fz)));
}
uvec2 Sign(uint start,uint count,uvec2 y,uvec2 inverse,
    inout uvec2 pastY[32],inout uvec2 pastValue[32],inout bool valid) {
    uvec2 value=inverse,lo=inverse,hi=inverse;
    for(uint j=0u;j<count;j++) {
        if(!B64Le(hi,B64_ZERO)&&!B64Ge(lo,B64_ZERO)) break;
        Octave o=ReadOctave(start+j);
        if(B64Ge(lo,o.stop)) return lo;
        if(B64Le(hi,B64Neg(o.stop))) return hi;
        uvec2 ey=B64Mul(y,o.fy);
        uvec2 delta=B64Sub(pastY[j],ey);
        uvec2 slope=B64Mul(B64Abs(delta),B64_FIVE);
        uvec2 lower=B64Sub(pastValue[j],slope),upper=B64Add(pastValue[j],slope);
        uvec2 v1=B64Mul(B64Max(B64_NEG_ONE,lower),o.amplitude),v2=B64Mul(B64Min(B64_ONE,upper),o.amplitude);
        lo=B64Add(lo,Threshold(v1,o.threshold,o.smoothing));
        hi=B64Add(hi,Threshold(v2,o.threshold,o.smoothing));
    }
    for(uint j=0u;j<count;j++) {
        Octave o=ReadOctave(start+j);
        if(B64Ge(value,o.stop)||B64Le(value,B64Neg(o.stop))) break;
        uvec2 ey=B64Mul(y,o.fy);
        uvec2 noise=Evaluate(o,ey,valid);
        pastValue[j]=noise; pastY[j]=ey;
        uvec2 scaled=B64Mul(noise,o.amplitude);
        value=B64Add(value,Threshold(scaled,o.threshold,o.smoothing));
    }
    return value;
}
void main() {
    uint column=gl_GlobalInvocationID.x; if(column>=data[0]) return;
    uint p=4u+column*4u;
    uint start=data[p],count=data[p+1u],first=data[p+2u],length=data[p+3u];
    // Own the complete cache here, including inactive entries copied by inout.
    uvec2 pastY[32],pastValue[32];
    for(uint j=0u;j<32u;j++) { pastY[j]=B64_QNAN; pastValue[j]=B64_ZERO; }
    bool valid=true;
    for(uint i=first;i<first+length;i++) {
        uint r=data[2]+i*4u;
        uvec2 sign=Sign(start,count,ReadBinary64(r),ReadBinary64(r+2u),pastY,pastValue,valid);
        // A sentinel causes the adapter to replay this entire column through the
        // untouched stock ColumnNoise, including its original past-evaluation order.
        results[i]=valid ? uint(B64Gt(sign,B64_ZERO)) : 0xffffffffu;
    }
}
