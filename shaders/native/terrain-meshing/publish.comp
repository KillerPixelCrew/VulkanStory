#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Source {uint source[];};
layout(std430,binding=1) writeonly buffer Faces {uint faces[];};
layout(std430,binding=2) writeonly buffer Colors {uint colors[];};
layout(push_constant) uniform Push {uint first;uint count;uint destination;uint padding;vec4 translation;}pc;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;uint s=(pc.first+i)*20u,d=(pc.destination+i)*16u;
for(uint k=0u;k<16u;k++)faces[d+k]=k<3u?floatBitsToUint(uintBitsToFloat(source[s+k])+pc.translation[k]):source[s+k];
for(uint k=0u;k<4u;k++)colors[(pc.destination+i)*4u+k]=source[s+16u+k];}
