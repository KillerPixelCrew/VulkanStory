#version 450
// Optimum ambient occlusion, pass 1 of 3: the working depth (docs/vulkan.md#ambient-occlusion C.1).
//
// Linearises the D32 depth of Primary into view-space depth (R32F; an fp16 position
// has 0.125-0.5 block steps at 200-500 blocks, fp32 does not) and builds five levels
// with XeGTAO's weighted-average filter, in one dispatch.
//
// Ported from XeGTAO's XeGTAO_PrefilterDepths16x16:
//
//   Copyright (C) 2016-2021, Intel Corporation
//   SPDX-License-Identifier: MIT
//   https://github.com/GameTechDev/XeGTAO
//
//   Permission is hereby granted, free of charge, to any person obtaining a copy
//   of this software and associated documentation files (the "Software"), to deal
//   in the Software without restriction, including without limitation the rights
//   to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
//   copies of the Software, and to permit persons to whom the Software is
//   furnished to do so, subject to the following conditions:
//
//   The above copyright notice and this permission notice shall be included in all
//   copies or substantial portions of the Software.
//
//   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
//   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
//   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
//   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
//   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
//   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
//   SOFTWARE.
//
// Bevy's preprocess_depth.wesl (MIT OR Apache-2.0) keeps the same one-dispatch shape.
//
// One 8x8 work group owns one 16x16 block of level 0 (one texel of level 4), as in
// XeGTAO: each invocation filters its 2x2 quad into level 1, and levels 2-4 reduce in
// workgroup shared memory between barrier() calls. barrier() in a compute shader is
// an execution and Workgroup-memory barrier (GL_KHR_vulkan_glsl), so the shared reads
// are ordered after the writes. Every level is the same filter of the same four
// values as one invocation doing the whole block, which left a 1080p frame only
// ~130 waves of serial work and per-invocation arrays in local memory.

layout(local_size_x = 8, local_size_y = 8) in;

#include "common.glsl"

layout(binding = 0) uniform sampler2D sourceDepth;
layout(binding = 1, GTAO_DEPTH_FORMAT) uniform writeonly image2D outDepth0;
layout(binding = 2, GTAO_DEPTH_FORMAT) uniform writeonly image2D outDepth1;
layout(binding = 3, GTAO_DEPTH_FORMAT) uniform writeonly image2D outDepth2;
layout(binding = 4, GTAO_DEPTH_FORMAT) uniform writeonly image2D outDepth3;
layout(binding = 5, GTAO_DEPTH_FORMAT) uniform writeonly image2D outDepth4;

shared float scratch[8][8];

ivec2 sourceSize;

float viewDepthAt(ivec2 texel)
{
    return gtaoViewDepth(texelFetch(sourceDepth, clamp(texel, ivec2(0), sourceSize - 1), 0).r);
}

void main()
{
    sourceSize = textureSize(sourceDepth, 0);
    ivec2 block = ivec2(gl_WorkGroupID.xy);
    // Uniform across the group, so no invocation skips a barrier another reaches.
    if (any(greaterThanEqual(block * 16, sourceSize))) return;
    ivec2 local = ivec2(gl_LocalInvocationID.xy);

    ivec2 size0 = imageSize(outDepth0);
    ivec2 size1 = imageSize(outDepth1);
    ivec2 size2 = imageSize(outDepth2);
    ivec2 size3 = imageSize(outDepth3);
    ivec2 size4 = imageSize(outDepth4);

    // Levels 0 and 1: this invocation's 2x2 quad.
    ivec2 texel1 = block * 8 + local;
    ivec2 texel0 = texel1 * 2;
    float depth0 = viewDepthAt(texel0);
    float depth1 = viewDepthAt(texel0 + ivec2(1, 0));
    float depth2 = viewDepthAt(texel0 + ivec2(0, 1));
    float depth3 = viewDepthAt(texel0 + ivec2(1, 1));
    if (all(lessThan(texel0 + ivec2(1, 1), size0)))
    {
        imageStore(outDepth0, texel0, vec4(depth0));
        imageStore(outDepth0, texel0 + ivec2(1, 0), vec4(depth1));
        imageStore(outDepth0, texel0 + ivec2(0, 1), vec4(depth2));
        imageStore(outDepth0, texel0 + ivec2(1, 1), vec4(depth3));
    }
    else
    {
        // An odd-sized edge: store only the texels inside level 0.
        if (all(lessThan(texel0, size0))) imageStore(outDepth0, texel0, vec4(depth0));
        if (all(lessThan(texel0 + ivec2(1, 0), size0))) imageStore(outDepth0, texel0 + ivec2(1, 0), vec4(depth1));
        if (all(lessThan(texel0 + ivec2(0, 1), size0))) imageStore(outDepth0, texel0 + ivec2(0, 1), vec4(depth2));
    }
    float filtered = gtaoDepthMipFilter(depth0, depth1, depth2, depth3);
    if (all(lessThan(texel1, size1))) imageStore(outDepth1, texel1, vec4(filtered));
    scratch[local.x][local.y] = filtered;
    barrier();

    // Level 2: every second invocation filters a 2x2 of level 1 and keeps the result
    // in its own slot, which no other invocation reads in this step.
    if (all(equal(local & 1, ivec2(0))))
    {
        filtered = gtaoDepthMipFilter(scratch[local.x][local.y], scratch[local.x + 1][local.y],
            scratch[local.x][local.y + 1], scratch[local.x + 1][local.y + 1]);
        ivec2 texel2 = block * 4 + local / 2;
        if (all(lessThan(texel2, size2))) imageStore(outDepth2, texel2, vec4(filtered));
        scratch[local.x][local.y] = filtered;
    }
    barrier();

    // Level 3.
    if (all(equal(local & 3, ivec2(0))))
    {
        filtered = gtaoDepthMipFilter(scratch[local.x][local.y], scratch[local.x + 2][local.y],
            scratch[local.x][local.y + 2], scratch[local.x + 2][local.y + 2]);
        ivec2 texel3 = block * 2 + local / 4;
        if (all(lessThan(texel3, size3))) imageStore(outDepth3, texel3, vec4(filtered));
        scratch[local.x][local.y] = filtered;
    }
    barrier();

    // Level 4.
    if (local == ivec2(0))
    {
        filtered = gtaoDepthMipFilter(scratch[0][0], scratch[4][0], scratch[0][4], scratch[4][4]);
        if (all(lessThan(block, size4))) imageStore(outDepth4, block, vec4(filtered));
    }
}
