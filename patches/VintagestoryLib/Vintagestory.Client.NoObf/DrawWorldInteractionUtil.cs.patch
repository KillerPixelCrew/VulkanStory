+	private double DrawControllerGlyph(string glyph, double x, double y, Context ctx, CairoFont font,
+		double lineheight, double textHeight, double pluswdith, double symbolspacing, double[] color)
+	{
+		if (x > 0.0)
+		{
+			capi.Gui.Text.DrawTextLine(ctx, font, "+", x + symbolspacing,
+				y + (lineheight - textHeight) / 2.0 + 2.0);
+			x += pluswdith + 2.0 * symbolspacing;
+		}
+		double textWidth = font.GetTextExtents(glyph).Width;
+		double glyphWidth = Math.Max(lineheight, textWidth + GuiElement.scaled(12.0));
+		if (glyph.Length == 1)
+		{
+			ctx.Arc(x + glyphWidth / 2.0, y + lineheight / 2.0, lineheight / 2.0 - 1.0,
+				0.0, Math.PI * 2.0);
+		}
+		else
+		{
+			GuiElement.RoundRectangle(ctx, x + 1.0, y + 1.0, glyphWidth - 2.0,
+				lineheight - 2.0, 5.0);
+		}
+		ctx.SetSourceRGBA(color);
+		ctx.LineWidth = 1.5;
+		ctx.StrokePreserve();
+		ctx.SetSourceRGBA(color[0], color[1], color[2], color[3] * 0.45);
+		ctx.Fill();
+		capi.Gui.Text.DrawTextLine(ctx, font, glyph,
+			x + (glyphWidth - textWidth) / 2.0, y + (lineheight - textHeight) / 2.0 + 2.0);
+		return x + glyphWidth + symbolspacing + 1.0;
+	}
