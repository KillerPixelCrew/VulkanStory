+	private void UpdateOptimumFpsCounter()
+	{
+		if (!OptimumConfig.ShowFpsCounter)
+		{
+			optimumFpsSampleTicks = 0L;
+			optimumLoopFrames = 0;
+			if (!displayFullDebugInfo && !displayOnlyFpsDebugInfo &&
+				!displayOnlyFpsDebugInfoTemporary && IsOpened()) DoClose();
+			return;
+		}
+		if (!IsOpened()) TryOpen();
+		optimumLoopFrames++;
+		string provider = OptimumConfig.EffectiveFrameGeneration;
+		long now = Stopwatch.GetTimestamp();
+		long real = OptimumConfig.RealPresentedFrames;
+		long displayed = OptimumConfig.SdkPresentedFrames;
+		if (optimumFpsSampleTicks == 0L || optimumLastProvider != provider)
+		{
+			optimumFpsSampleTicks = now;
+			optimumLastRealPresents = real;
+			optimumLastSdkPresents = displayed;
+			optimumLoopFrames = 0;
+			optimumLastProvider = provider;
+			optimumFpsText.SetNewTextAsync(provider == "off"
+				? "Real: -- FPS  |  FG: Off"
+				: "Real: -- FPS  |  FG output: -- FPS");
+			return;
+		}
+		double seconds = (now - optimumFpsSampleTicks) / (double)Stopwatch.Frequency;
+		if (seconds < 1.0) return;
+		double realFps = (OptimumRender.IsVulkan ? real - optimumLastRealPresents : optimumLoopFrames) / seconds;
+		double displayFps = (displayed - optimumLastSdkPresents) / seconds;
+		optimumFpsText.SetNewTextAsync(provider == "off"
+			? $"Real: {realFps:0} FPS  |  FG: Off"
+			: $"Real: {realFps:0} FPS  |  FG output: {displayFps:0} FPS");
+		optimumFpsSampleTicks = now;
+		optimumLastRealPresents = real;
+		optimumLastSdkPresents = displayed;
+		optimumLoopFrames = 0;
+	}
